@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<div style="max-width: 700px; margin: 0 auto; padding: 20px;">
    <h1>Welcome to Friend & Pet Overview</h1>

    <p>
        This application lets you explore friends and pets based on where they live.
        You can browse by country, see which cities have the most friends, and compare
        how many pets each city has. Everything is shown using simple cards so it’s
        easy to get an overview.
    </p>
</div>