@page
@model Pages.OverviewModel
@{
}

<div class="container">
    <div class="row g-4">
        @foreach (var country in Model.dbInfo.Item.Friends)
        {
            @if (string.IsNullOrWhiteSpace(country.City) && !string.IsNullOrWhiteSpace(country.Country))
            {

                <div class="col-sm-6 col-md-4 col-lg-3">
                    <a asp-page="/Overview" asp-route-country=@country.Country
                        class="btn card-link @(Model.SelectedCountry == country.Country ? "active-card" : "")" type="button">
                        <div class="card p-4 mb-4 ">
                            <div class="d-flex">
                                <h2>@country.Country</h2>
                            </div>
                            <div>
                                <h4><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor"
                                        class="bi bi-people-fill" viewBox="0 0 16 16">
                                        <path
                                            d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.24 2.24 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.3 6.3 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5" />
                                    </svg> @country.NrFriends</h4>
                            </div>
                        </div>
                    </a>
                </div>

            }
        }
    </div>
</div>

<div class="container border-top">
    <div class="row g-4 mt-3">
        @foreach (var city in Model.CityStats)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card p-4 mb-4 ">
                    <div class="d-flex">
                        <h2>@city.City</h2>
                    </div>
                    <div class="d-block">
                        <h4><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor"
                                class="bi bi-people-fill" viewBox="0 0 16 16">
                                <path
                                    d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.24 2.24 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.3 6.3 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5" />
                            </svg> @city.NrFriends</h4>
                        <h4><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor"
                                class="bi bi-bug-fill" viewBox="0 0 16 16">
                                <path
                                    d="M4.978.855a.5.5 0 1 0-.956.29l.41 1.352A5 5 0 0 0 3 6h10a5 5 0 0 0-1.432-3.503l.41-1.352a.5.5 0 1 0-.956-.29l-.291.956A5 5 0 0 0 8 1a5 5 0 0 0-2.731.811l-.29-.956z" />
                                <path
                                    d="M13 6v1H8.5v8.975A5 5 0 0 0 13 11h.5a.5.5 0 0 1 .5.5v.5a.5.5 0 1 0 1 0v-.5a1.5 1.5 0 0 0-1.5-1.5H13V9h1.5a.5.5 0 0 0 0-1H13V7h.5A1.5 1.5 0 0 0 15 5.5V5a.5.5 0 0 0-1 0v.5a.5.5 0 0 1-.5.5zm-5.5 9.975V7H3V6h-.5a.5.5 0 0 1-.5-.5V5a.5.5 0 0 0-1 0v.5A1.5 1.5 0 0 0 2.5 7H3v1H1.5a.5.5 0 0 0 0 1H3v1h-.5A1.5 1.5 0 0 0 1 11.5v.5a.5.5 0 1 0 1 0v-.5a.5.5 0 0 1 .5-.5H3a5 5 0 0 0 4.5 4.975" />
                            </svg> @city.NrPets</h4>
                    </div>
                </div>

            </div>
        }
    </div>
</div>